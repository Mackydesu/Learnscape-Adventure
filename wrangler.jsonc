
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "learnscape-adventure",
  "compatibility_date": "2026-10-06",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  }
}
